*.edf
*.edf+
*.bdf
*.gdf
*.vhdr
*.vmrk
*.eeg
*.set
*.fdt
*.cnt
*.mff
*.xdf
*.fif
*.fif.gz
*.nwb
*.dat
*.raw
# Formatos de datos científicos / matrices
*.mat
*.h5
*.hdf5
*.nc
*.npy
*.npz
*.parquet
*.feather
*.arrow
*.jld
*.jld2
*.bson
*.pkl
*.pickle
*.joblib
*.csv.gz
*.tsv.gz
# Neuroimagen
*.nii
*.nii.gz

# ---------------------------------------------------------------------
# Información sensible y credenciales
# ---------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.crt
id_rsa*
id_ed25519*
credentials*
secrets*
*.secret
*.token
.netrc
# Información de participantes / pacientes
participants_private*
*_private.*
private/
confidential/

# ---------------------------------------------------------------------
